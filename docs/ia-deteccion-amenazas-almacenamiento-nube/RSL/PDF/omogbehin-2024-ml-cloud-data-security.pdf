<head>
	<title>Securing cloud data with machine learning: trends, gaps, and performance metrics | Ifeoluwa Omogbehin | IAES International Journal of Artificial Intelligence (IJ-AI)</title>
	<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
	<meta name="description" content="Securing cloud data with machine learning: trends, gaps, and performance metrics" />
			<meta name="keywords" content="Adversarial attacks; Cloud computing security; Data access control; Deep learning; Machine learning" />
	
	<link rel="icon" href="https://ijai.iaescore.com/public/journals/6/journalFavicon_en_US.ico" type="image/x-icon" />
	<link rel="schema.DC" href="http://purl.org/dc/elements/1.1/" />

