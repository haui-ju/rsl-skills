# Graphify memory / generated graphs (root + per-theme + thesaurus) — regenerar con pnpm run bootstrap
graphify-out/
**/graphify-out/

# IEEE Thesaurus derivados (CC BY-NC-ND; regenerar con pnpm graphify:thesaurus:refresh)
global/thesaurus/*.json
# ACM CCS 2012 derivado (regenerar con pnpm graphify:thesaurus:refresh)
global/thesaurus/acm-ccs/*.json

# Regenerable pdftotext dumps
**/RSL/MD/_raw/
global/bibliography/**/_raw/

# Bibliografía compartida: PDF sin licencia abierta (el enlace está en global/bibliography/bibliography.md)
global/bibliography/picoc/kitchenham-charters-2007.pdf

# Node / pnpm
node_modules/
.pnpm-store/

# Python
__pycache__/
*.pyc

# Env / OS
.env
.env.*
!.env.example
.DS_Store
